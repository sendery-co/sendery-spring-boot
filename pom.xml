<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion><groupId>co.sendery</groupId><artifactId>sendery-spring-boot-starter</artifactId><version>0.1.4</version>
<name>sendery-spring-boot-starter</name><description>Sendery template email SDK</description><url>https://sendery.co/en/docs</url>
<licenses><license><name>MIT</name><url>https://opensource.org/license/mit</url></license></licenses>
<developers><developer><id>sendery</id><name>Sendery contributors</name></developer></developers>
<properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
<dependencies><dependency><groupId>co.sendery</groupId><artifactId>sendery-java</artifactId><version>0.1.4</version></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><version>4.1.1</version></dependency>
